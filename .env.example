# Neon PostgreSQL pooled URL. Never prefix database credentials with VITE_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Model credentials are only read by the server.
BATCH_LAB_MODEL_KEY=
# Optional team password; omit for an open shared workspace.
BATCH_LAB_ACCESS_KEY=
# Optional compatible model endpoint and extra allowed hostnames.
# BATCH_LAB_MODEL_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# BATCH_LAB_ALLOWED_MODEL_HOSTS=api.example.com
